          <Path path="183" as="184" dim="171" />
        </Paths>
      </Formula>
      <Formula id="DiffusionCommon_PKSim.PARAM_P_pls_rbc" name="PARAM_P_pls_rbc" dim="Velocity" formula="P * P_pls_rbc_factor">
        <Paths>
          <Path path="185" as="186" />
          <Path path="183" as="184" dim="171" />
        </Paths>
      </Formula>
      <BlackBoxFormula id="BlackBox_CalculationMethod.CELLULAR PERMEABILITY FACTOR RATE" name="CELLULAR PERMEABILITY FACTOR RATE" />
      <BlackBoxFormula id="BlackBox_CalculationMethod.PARTITION COEFFICIENT FORMULA" name="PARTITION COEFFICIENT FORMULA" />
      <Formula id="DistributionInVitro_PKSim.PARAM_fu" name="PARAM_fu" dim="Fraction" formula="Min(1 / (1 + (BindingPartner = Albumin ? AlbuminOntgenyFactor : (BindingPartner = Agp ? AgpOntogenyFactor : 1) ) * (1 - fu_ref) / fu_ref) * PlasmaProteinScaleFactor; 1)">
        <Paths>
          <Path path="187" as="188" />
          <Path path="189" as="190" />
          <Path path="191" as="192" dim="193" />
          <Path path="194" as="195" />
          <Path path="196" as="197" />
          <Path path="198" as="199" />
          <Path path="200" as="201" />
        </Paths>
      </Formula>
      <Formula id="DistributionInVitro_PKSim.PARAM_Blood2Plasma" name="PARAM_Blood2Plasma" formula="(f_water_rbc + f_lipids_rbc * 10^LogP + f_proteins_rbc * KProt) * fu * HCT - HCT + 1">
        <Paths>
          <Path path="202" as="203" dim="193" />
          <Path path="204" as="205" dim="206" />
          <Path path="207" as="208" />
          <Path path="209" as="210" />
          <Path path="211" as="212" />
          <Path path="213" as="214" />
          <Path path="215" as="216" />
