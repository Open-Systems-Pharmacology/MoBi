      <Formula id="Individual_PKSim.PARAM_CLSpec_endosomal_global" name="PARAM_CLSpec_endosomal_global" dim="Inversed time" formula="K_uptake-K_rec&gt;=0 ? K_uptake-K_rec : 0">
        <Paths>
          <Path path="217" as="218" dim="219" />
          <Path path="220" as="221" dim="219" />
        </Paths>
      </Formula>
      <SumFormula id="DynamicSumFormulas.PARAM_VolumePlasma" name="PARAM_VolumePlasma" dim="Volume" variable="V" formulaString="V_#i">
        <Criteria operator="And">
          <DescriptorConditions>
            <InContainerCondition tag="Plasma" />
            <MatchTagCondition tag="Volume" />
            <NotInContainerCondition tag="Pericentral" />
            <NotInContainerCondition tag="Periportal" />
            <NotInContainerCondition tag="EndogenousIgG" />
          </DescriptorConditions>
        </Criteria>
      </SumFormula>
      <Formula id="Individual_PKSim.PARAM_BW" name="PARAM_BW" dim="Mass" formula="Weight_blood + Weight_tissue">
