      </Formula>
      <Formula id="IntestinalPermeabilityCommon_PKSim.PARAM_P_int" name="PARAM_P_int" dim="Velocity" formula="10 ^ (m * log10 (P_int_InVitro) + b)">
        <Paths>
          <Path path="172" as="173" />
          <Path path="174" as="175" />
          <Path path="176" as="170" dim="171" />
        </Paths>
      </Formula>
      <Formula id="IntestinalPermeabilityCommon_PKSim.PARAM_MucosaPermeabilityScaleFactor_trans" name="PARAM_MucosaPermeabilityScaleFactor_trans" formula="P_int_trans_default &gt;0 ? P_int_trans / P_int_trans_default : 0">
        <Paths>
          <Path path="177" as="178" dim="171" />
          <Path path="179" as="180" dim="171" />
        </Paths>
      </Formula>
      <Formula id="DiffusionCommon_PKSim.PARAM_P_rbc_pls" name="PARAM_P_rbc_pls" dim="Velocity" formula="P * P_rbc_pls_factor">
