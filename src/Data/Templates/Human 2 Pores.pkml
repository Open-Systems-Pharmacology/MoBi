    <Formulas>
      <Formula id="IntestinalPermeabilityCommon_PKSim.PARAM_P_int_default" name="PARAM_P_int_default" dim="Velocity" formula="10 ^ (m * log10 (P_int_InVitro) + b)">
        <Paths>
          <Path path="169" as="170" dim="171" />
          <Path path="172" as="173" />
          <Path path="174" as="175" />
